# Salin ke .env dan isi nilainya. Jangan commit .env.
# Koneksi Postgres (login role payray_app di production)
DATABASE_URL=postgresql://payray_app:CHANGE_ME@127.0.0.1:54329/payray_dev
# Kunci HMAC pseudonim NIK, minimal 32 byte (mis. python -c "import secrets;print(secrets.token_hex(32))")
PAYRAY_NIK_KEY=
# Tampilan estimasi Rp: range | band
PAYRAY_RP_MODE=range
# Mode frontend: live | static
MODE=live
